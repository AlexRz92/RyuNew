# ============================================================================
#  VARIABLES DE ENTORNO — PLANTILLA DE E-COMMERCE
# ============================================================================
# Copia este archivo a .env y rellena los valores.
# En Vercel: Settings > Environment Variables (Production, Preview y Development).
#
# Las variables VITE_* se incrustan en el build: tras cambiarlas hay que
# volver a desplegar para que tengan efecto.
# ============================================================================

# --- Supabase (OBLIGATORIAS) ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# --- Identidad del negocio (OPCIONALES: si se omiten, usa los valores por
#     defecto definidos en src/config/store.config.ts) ---
# Cambia estos valores para adaptar la plantilla a otro rubro
# (licorería, abasto, pizzería, etc.) sin tocar el código.

# VITE_STORE_NAME="Ferretería RYU"
# VITE_STORE_TAGLINE="Todo para tu hogar"
# VITE_STORE_DESCRIPTION="Todo para tu hogar"

# Assets de marca (rutas dentro de /public)
# VITE_STORE_LOGO="/ryu.png"
# VITE_STORE_LOGO_TEXT="/ferreteria.png"
# VITE_STORE_FAVICON="/ryu.png"
# VITE_STORE_OG_IMAGE="/og.png"

# Finanzas
# VITE_STORE_CURRENCY_SYMBOL="$"
# VITE_STORE_CURRENCY_CODE="USD"
# VITE_STORE_LOCALE="es-VE"
# VITE_STORE_TAX_RATE="0.16"          # 0.16 = 16% (IVA Venezuela). Usa 0 si no aplica impuesto.
# VITE_STORE_TAX_LABEL="IVA"

# Textos de la interfaz
# VITE_STORE_CATALOG_TITLE="Todos los productos"
# VITE_STORE_FEATURED_TITLE="Productos más vendidos"
# VITE_STORE_EMPTY_CATALOG="No hay productos disponibles"

# Contacto (opcional; deja vacío para ocultar)
# VITE_STORE_WHATSAPP=""
# VITE_STORE_INSTAGRAM=""
# VITE_STORE_EMAIL=""

# Catálogo
# VITE_STORE_PRODUCTS_PER_PAGE="10"
